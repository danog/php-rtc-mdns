{
    "name": "danog/php-rtc-mdns",
    "type": "library",
    "description": "An Amp v3 Multicast DNS resolver for WebRTC. MadelineProto's PHP 8.2+ fork is a Composer-compatible component of the modular danog/php-rtc stack.",
    "keywords": [
        "multicastdns",
        "mdns"
    ],
    "homepage": "https://github.com/danog/php-rtc-mdns",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "amphp/socket": "^2.3",
        "daverandom/libdns": "^2.0.2",
        "danog/php-rtc-exception": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\MDNS\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\MDNS\\": "tests"
        }
    },
    "minimum-stability": "dev"
}
